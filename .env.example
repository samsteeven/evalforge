# Copier en .env à la racine du dépôt.
EVALFORGE_DATABASE_URL=postgresql+asyncpg://evalforge:evalforge@localhost:5435/evalforge
EVALFORGE_RABBITMQ_URL=amqp://evalforge:evalforge@localhost:5672/
# Chiffrement des clés d'API en base, clé Fernet :
#   uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
EVALFORGE_SECRET_KEY=
# Signature des jetons d'accès, 32 caractères aléatoires au moins :
#   uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
EVALFORGE_JWT_SECRET_KEY=
# Développement local en http : le cookie de session ne peut pas être « Secure ».
EVALFORGE_COOKIE_SECURE=false
# Autorise un fournisseur sur une adresse locale (Ollama, faux fournisseur) : jamais en production.
EVALFORGE_ALLOW_PRIVATE_PROVIDER_URLS=true
