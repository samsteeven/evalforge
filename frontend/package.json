{
  "name": "evalforge-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "api:types": "npx --yes -p typescript@5.9 -p openapi-typescript@7 openapi-typescript openapi.json -o src/api/schema.d.ts",
    "test": "vitest run",
    "typecheck": "tsc -b && tsc -p cypress/tsconfig.json",
    "e2e:web": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "cy:run": "cypress run",
    "e2e": "start-server-and-test e2e:backend \"http-get://127.0.0.1:8100/docs|http-get://127.0.0.1:8000/health\" e2e:web http-get://127.0.0.1:5173 cy:run",
    "e2e:backend": "node cypress/start-backend.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.106.0",
    "openapi-fetch": "^0.17.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.4",
    "@testing-library/cypress": "^10.1.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "cypress": "^16.2.1",
    "jsdom": "^30.1.3",
    "oxlint": "^1.89.0",
    "start-server-and-test": "^3.0.13",
    "tailwindcss": "^4.3.4",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
